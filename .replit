modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "production-smoke"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "expo-install-check"

[[workflows.workflow]]
name = "production-smoke"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/orivis run test:smoke"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "expo-install-check"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/orivis-mobile run check:expo"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.shared]

[nix]
channel = "stable-25_05"
packages = ["killall"]

[objectStorage]
defaultBucketID = "replit-objstore-00b83fdf-2f2b-4edf-8da4-b041ec9b901d"

[[ports]]
localPort = 8081
externalPort = 80
